<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly local brain sweep on a Mac. Replace the three paths, save as
     ~/Library/LaunchAgents/com.marketingbrain.sweep.plist, then run:
     launchctl load ~/Library/LaunchAgents/com.marketingbrain.sweep.plist
     Runs Mondays at 08:00 local time if the Mac is awake (or at the next wake). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.marketingbrain.sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOU/path/to/brain_sweep_local.py</string>
    <string>--repo</string>
    <string>/Users/YOU/path/to/acme-marketing-brain</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/YOU/.local/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/brain-sweep.log</string>
  <key>StandardErrorPath</key><string>/tmp/brain-sweep.log</string>
</dict>
</plist>
